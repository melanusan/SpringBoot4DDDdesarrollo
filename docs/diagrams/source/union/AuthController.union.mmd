sequenceDiagram
    autonumber
    participant Client as Cliente
    participant API as "erp-api<br/>AuthController"
    participant Sec as "erp-application/security<br/>AuthenticationManager"
    participant UserSrv as "erp-infrastructure<br/>UserDetailsService / UserRepository"
    participant JWT as "erp-infrastructure<br/>JWTService"
    participant Domain as "erp-domain<br/>UserEntity"
    participant Common as "erp-common<br/>AuthRequest / AuthResponse / AppUserDetails"

    Client->>API: POST /auth/login { username, password }
    API->>Sec: authenticationManager.authenticate(UsernamePasswordAuthenticationToken)
    Sec->>UserSrv: loadUserByUsername(username)
    UserSrv->>Domain: fetch user record
    Domain-->>UserSrv: user data
    UserSrv-->>Sec: UserDetails (AppUserDetails)
    Sec-->>API: Authentication(principal=AppUserDetails)
    API->>JWT: jwtService.generateToken(AppUserDetails)
    JWT-->>API: token string
    API-->>Client: 200 OK { token }
